{
  "schema": 1,
  "apps": {
    "path": "apps/*",
    "manifest": "app.json",
    "mguHmi": [
      "ID7"
    ],
    "requires": {
      "cluster-render": "0.5.1"
    },
    "build": {
      "python": "build.py",
      "args": [
        "{id}"
      ],
      "sdk": "oap-sdk",
      "output": "dist/{id}.tgz",
      "shared": [
        "source.zip",
        "build.py",
        "oap-sdk"
      ]
    }
  }
}
